{
  "features": [
    {
      "id": "subagent",
      "name": "子代理委派框架 (Subagent)",
      "category": "agent",
      "description": "对齐 DSH 语义的子代理委派与后台 Job 任务，支持独立上下文多步检索与推理",
      "estimatedSize": "95 KB",
      "defaultEnabled": true,
      "configKey": "subagent",
      "subCmd": "subagent"
    },
    {
      "id": "knowledge",
      "name": "知识库 RAG 检索 (Knowledge Base)",
      "category": "memory",
      "description": "支持导入本地文档进行分块切片与相关度检索，自动为模型注入上下文",
      "estimatedSize": "65 KB",
      "defaultEnabled": true,
      "configKey": "knowledgeBase",
      "subCmd": "kb"
    },
    {
      "id": "memory",
      "name": "长期记忆系统 (Long-term Memory)",
      "category": "memory",
      "description": "会话级与用户级长期记忆存储，跨会话记忆与语义召回",
      "estimatedSize": "45 KB",
      "defaultEnabled": true,
      "configKey": "memory",
      "subCmd": "memory"
    },
    {
      "id": "mcp",
      "name": "MCP 扩展协议客户端 (Model Context Protocol)",
      "category": "agent",
      "description": "支持通过 SSE 或 stdio 外接外部 MCP 服务，将第三方工具无缝挂载给模型",
      "estimatedSize": "35 KB",
      "defaultEnabled": true,
      "configKey": "mcp",
      "subCmd": "mcp"
    },
    {
      "id": "skills",
      "name": "外部技能体系 (Skills System)",
      "category": "core",
      "description": "基于 SKILL.md 的提示词按需检索与注入系统",
      "estimatedSize": "25 KB",
      "defaultEnabled": true,
      "configKey": "skills",
      "subCmd": "skill"
    },
    {
      "id": "image",
      "name": "AI 绘画与图像处理 (Image Generation)",
