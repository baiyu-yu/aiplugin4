      "description": "网易云/QQ音乐点歌服务解析以及预设/自定义音色 TTS 语音合成",
      "estimatedSize": "20 KB",
      "defaultEnabled": true
    },
    {
      "id": "pub_forum",
      "name": "公共广场与社区交互 (Pub & Forum)",
      "category": "system",
      "description": "跨会话公开频道与论坛帖子读写交互",
      "estimatedSize": "35 KB",
      "defaultEnabled": true,
      "subCmd": "pub"
    },
    {
      "id": "timer",
      "name": "定时任务与提醒 (Timer & Cron)",
