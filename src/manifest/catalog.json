      "description": "调用生图模型与图片处理管线，支持多平台图片回复",
      "estimatedSize": "30 KB",
      "defaultEnabled": true,
      "configKey": "image",
      "subCmd": "image"
    },
    {
      "id": "music_voice",
      "name": "点歌与语音合成 (Music & TTS)",
