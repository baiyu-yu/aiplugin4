      "toolNames": ["list_tools", "search_tools", "call_tool"],
      "estimatedSize": "15 KB",
      "defaultEnabled": true,
      "importPath": "./core/tool_dispatch",
      "registerFn": "registerDispatchTools"
    },
    {
      "id": "tool_time",
      "name": "当前时间查询 (Time)",
      "category": "core",
